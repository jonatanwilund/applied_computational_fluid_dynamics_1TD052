{
  "name": "FEniCSx 0.11.0",
  "image": "ghcr.io/fenics/dolfinx/dolfinx:v0.11.0",
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/dolfinx-env",
    "VIRTUAL_ENV": "/dolfinx-env",
    "DISPLAY": ":0",
    "MPLBACKEND": "TkAgg"
  },
  "remoteEnv": {
    "PATH": "/dolfinx-env/bin:${containerEnv:PATH}"
  },
  "features": {
    "ghcr.io/devcontainers-extra/features/uv:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/dolfinx-env/bin/python",
        "python.analysis.extraPaths": [
          "/dolfinx-env/lib/python3.10/site-packages",
          "/dolfinx-env/lib/python3.11/site-packages",
          "/dolfinx-env/lib/python3.12/site-packages"
        ]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "apt-get update && apt-get install -y python3-tk && uv pip install jax",
  "remoteUser": "root"
}